# Copy to .env to override local development defaults. .env is git-ignored; never commit it.
# Read by both `make` and `docker compose`.
#
# Everything here is for LOCAL DEVELOPMENT ONLY. The API refuses to start with RELAY_ENV=production
# when the database password contains "local_dev_only".

# PostgreSQL password for the Compose database. Changing it after the volume exists requires
# recreating the volume (docker compose down -v), which deletes local data.
RELAY_DB_PASSWORD=relay_local_dev_only

# Host ports (bound to 127.0.0.1 only).
RELAY_DB_HOST_PORT=55432
RELAY_API_HOST_PORT=8000
RELAY_WEB_HOST_PORT=3000

# API log level: DEBUG, INFO, WARNING or ERROR.
RELAY_LOG_LEVEL=INFO

# AI investigation (optional). Every workflow works with RELAY_AI_PROVIDER=disabled.
# RELAY_AI_PROVIDER=disabled
# RELAY_AI_MODEL=claude-opus-5
# Set a provider key only in your own environment or .env; never commit it.
# ANTHROPIC_API_KEY=
