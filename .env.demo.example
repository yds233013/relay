# Copy to .env.demo and fill in. Git-ignored; never commit the result.
# Used only with the public-demo overlay:
#
#   docker compose --env-file .env.demo \
#     -f docker-compose.yml -f docker-compose.demo.yml up -d --build
#
# Read docs/public-demo.md first. This mode serves a fictional company to anonymous visitors and
# refuses every mutation but one. It is not production and must not hold real data.

# ---------------------------------------------------------------------------- database (required)
# No defaults: the overlay refuses to render if any of these three is unset or blank. Still a real
# password — RELAY_ENV=demo rejects the local development one exactly as production does, because
# a public demo is reachable from the internet too.
RELAY_DB_USER=relay
RELAY_DB_PASSWORD=
RELAY_DB_NAME=relay

RELAY_DB_POOL_SIZE=10

# ------------------------------------------------------------------------------------- web tier
# Keep the loopback bind and terminate TLS in a reverse proxy in front of it.
RELAY_WEB_BIND=127.0.0.1
RELAY_WEB_HOST_PORT=3000

# --------------------------------------------------------------------------------------- logging
RELAY_LOG_LEVEL=INFO

# --------------------------------------------------------------------------- resources / restart
RELAY_DB_MEMORY_LIMIT=2g
RELAY_API_CPU_LIMIT=2
RELAY_API_MEMORY_LIMIT=1g
RELAY_WORKER_CPU_LIMIT=1
RELAY_WORKER_MEMORY_LIMIT=1g
RELAY_WEB_CPU_LIMIT=1
RELAY_WEB_MEMORY_LIMIT=1g
RELAY_WORKER_STOP_GRACE=30s

# ------------------------------------------------------------------------------------------- AI
# There is deliberately nothing to configure. The overlay pins RELAY_AI_PROVIDER=demo, which
# replays authored transcripts against this database: no key, no network call, no cost. Setting
# ANTHROPIC_API_KEY here would achieve nothing — RELAY_ENV=demo refuses the paid provider at
# startup, so the process would not run with it even if a key were present.
