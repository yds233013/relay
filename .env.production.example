# Copy to .env.production and fill in. Git-ignored by the `.env.*` rule; never commit the result.
# Used only with the deployment overlay:
#
#   docker compose --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Read docs/deployment.md first. Relay has no authentication yet; see the "Before you deploy
# anything" section there for what that means.
#
# Every RELAY_* name below is read by relay.core.config.Settings (env_prefix="RELAY_"). Settings
# are validated at startup and an invalid configuration fails fast.

# ---------------------------------------------------------------------------- database (required)
# No defaults: the overlay refuses to start if any of these three is unset.
# The password must be a real one. RELAY_ENV=production rejects an empty password and any password
# containing "local_dev_only". Changing the password after the volume exists does not change the
# role's password inside PostgreSQL — ALTER ROLE first, or recreate the volume and restore a dump.
RELAY_DB_USER=relay
RELAY_DB_PASSWORD=
RELAY_DB_NAME=relay

# SQLAlchemy pool size per process (api and worker each hold their own). 1-50.
RELAY_DB_POOL_SIZE=10

# ------------------------------------------------------------------------------------- web tier
# Host interface and port for the web container. Keep the default loopback bind and put a reverse
# proxy in front to terminate TLS and apply access control. Set 0.0.0.0 only when something else
# is doing that job.
RELAY_WEB_BIND=127.0.0.1
RELAY_WEB_HOST_PORT=3000

# --------------------------------------------------------------------------------------- logging
# DEBUG, INFO, WARNING or ERROR. Format is forced to json in production.
RELAY_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------------- limits
# Per-request upload ceiling in bytes (default 50 MiB), rows accepted from one file, and the
# per-person hourly upload budget (SEC-17). Loading one migration uploads about 16 files.
RELAY_MAX_UPLOAD_BYTES=52428800
RELAY_MAX_ROWS_PER_IMPORT=500000
RELAY_MAX_UPLOADS_PER_HOUR=300

# --------------------------------------------------------------------------- resources / restart
RELAY_DB_MEMORY_LIMIT=2g
RELAY_API_CPU_LIMIT=2
RELAY_API_MEMORY_LIMIT=1g
RELAY_WORKER_CPU_LIMIT=2
RELAY_WORKER_MEMORY_LIMIT=2g
RELAY_WEB_CPU_LIMIT=1
RELAY_WEB_MEMORY_LIMIT=1g
# How long a stopping worker may keep finishing an in-flight job before SIGKILL.
RELAY_WORKER_STOP_GRACE=120s

# ------------------------------------------------------------------- AI investigation (optional)
# Every workflow works with 'disabled', which is the default and the right value unless you have
# deliberately decided otherwise. 'demo' and 'scripted' replay authored transcripts and are for the
# demo and tests only: never run them anywhere their output could be read as a model's reasoning.
# 'anthropic' calls a live model and requires ANTHROPIC_API_KEY; startup fails without it.
RELAY_AI_PROVIDER=disabled
RELAY_AI_MODEL=claude-opus-5

# Supply the key through your platform's secret store and leave this blank in the file. Anything
# written here lands on disk in plain text.
ANTHROPIC_API_KEY=
