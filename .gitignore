# Secrets and local environment. The *.example templates are committed; nothing else matching
# .env* is, so .env.production (a real one) stays out even though .env.production.example is in.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
dist/
build/

# Node / Next.js
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
playwright-report/
test-results/
npm-debug.log*

# Local data, databases and logs
/data/
*.sqlite
*.sqlite3
*.db
*.log
logs/

# Scratch and generated output
tmp/
.tmp/
*.tmp

# OS / editors
.DS_Store
.idea/
.vscode/

# Local blob storage for host-run API and worker
backend/.data/
