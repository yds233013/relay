# Copy to .env.public on the server and fill in. Git-ignored; never commit the result, and never
# paste its contents into a chat window.
#
#   cp .env.public.example .env.public && $EDITOR .env.public
#
# Used only with the public deployment stack (docs/public-deployment.md):
#
#   make public-config     render and validate, start nothing
#   make public-init       first run: migrate, seed, enable demo AI, start
#   make public-up         start / update
#
# This deployment serves ONE fictional company to anonymous visitors, refuses every mutation but
# starting an investigation, and cannot reach a paid AI provider. It is not production and must
# never hold real data.

# ------------------------------------------------------------------------ public name (required)
# The hostname the certificate is issued for and the only Host the edge answers. A DNS A record
# (and AAAA if the VM has IPv6) must already point it at this machine before the stack starts,
# or ACME cannot validate and Caddy will retry until it does. No default: a wrong value here is a
# failed certificate, so it has to be stated.
RELAY_PUBLIC_HOST=relay.example.com

# Contact address Let's Encrypt uses for expiry and policy notices. A real mailbox you read.
RELAY_ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------- database (required)
# A real password. RELAY_ENV=demo refuses a blank one and refuses the local development one, so
# leaving this empty fails the stack at startup rather than quietly exposing a known credential.
# Generate on the server, never in a chat window:
#
#   openssl rand -base64 32
#
RELAY_DB_USER=relay
RELAY_DB_PASSWORD=
RELAY_DB_NAME=relay

RELAY_DB_POOL_SIZE=10

# ------------------------------------------------------------------------------------------- edge
# HSTS lifetime in seconds. Start at 300 for the first day if you want an escape hatch from a
# mis-issued certificate, then raise it to a year. No `preload` is sent at any value.
RELAY_HSTS_MAX_AGE=31536000

# Largest request body the edge will pass. The demo accepts no uploads; the one permitted write is
# a small form post, so this only bounds abuse.
RELAY_MAX_BODY=1MB

# --------------------------------------------------------------------------------------- logging
RELAY_LOG_LEVEL=INFO

# --------------------------------------------------------------------------- resources / restart
# Sized for the 2 vCPU / 4 GB VM in docs/public-deployment.md §12. Raise with the machine.
RELAY_DB_MEMORY_LIMIT=1g
RELAY_API_CPU_LIMIT=1
RELAY_API_MEMORY_LIMIT=768m
RELAY_WORKER_CPU_LIMIT=1
RELAY_WORKER_MEMORY_LIMIT=768m
RELAY_WEB_CPU_LIMIT=1
RELAY_WEB_MEMORY_LIMIT=512m
RELAY_CADDY_CPU_LIMIT=1
RELAY_CADDY_MEMORY_LIMIT=256m
RELAY_WORKER_STOP_GRACE=30s

# --------------------------------------------------------------------------------- not used here
# The public overlay stops publishing the web tier to the host — Caddy reaches it over the private
# compose network — so these two are inert. They stay because the demo overlay declares them.
RELAY_WEB_BIND=127.0.0.1
RELAY_WEB_HOST_PORT=3000

# ------------------------------------------------------------------------------------------- AI
# There is deliberately nothing to configure and no key to hold. The demo overlay pins
# RELAY_AI_PROVIDER=demo, which replays authored transcripts against this database: no network
# call, no key, no cost. RELAY_ENV=demo refuses the paid provider at startup, so the process would
# not run with it even if a key were present.
